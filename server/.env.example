# Copiare in .env (mai committato) e valorizzare
NODE_ENV=development
PORT=3002

DATABASE_URL=postgresql://hclub:CAMBIAMI@127.0.0.1:5432/handmade_clienti

# Segreto per le sessioni httpOnly (cliente/operatore/admin)
JWT_SESSION_SECRET=CAMBIAMI

# Segreto per il QR rotante del cliente (breve durata)
JWT_QR_SECRET=CAMBIAMI

# Provider invio OTP: 'console' (solo log: il cliente NON riceve nulla) | 'skebby'
SMS_PROVIDER=console
# Skebby (https://www.skebby.it) — solo con SMS_PROVIDER=skebby
SKEBBY_USER=
SKEBBY_PASSWORD=
SKEBBY_SENDER=HandmadeCl
SKEBBY_MESSAGE_TYPE=GP

# Origine consentita per i cookie in produzione (dominio pubblico https)
COOKIE_SECURE=false

# Integrazione cassa TGS Retail (WebService Fidelity) — spenta finché TGS_ENABLED=true.
# Con TGS spento gli agganci nel codice non fanno nulla e la coda non parte.
TGS_ENABLED=false
# Dall'esterno: inoltro 5.154.199.20:9443 -> 192.168.10.10:9010 (server di cassa Fiano)
TGS_BASE_URL=https://5.154.199.20:9443
TGS_USER=
TGS_PASSWORD=
# Impronta SHA-256 del certificato autofirmato del WebService (si accetta solo quello).
# Si legge con: openssl s_client -connect 5.154.199.20:9443 </dev/null 2>/dev/null | openssl x509 -fingerprint -sha256 -noout
TGS_CERT_FINGERPRINT=
TGS_TIMEOUT_MS=4000
# Percorsi: valori di default in services/tgs/fidelity.js; qui si sovrascrivono
# quando TGS conferma la specifica, senza toccare il codice.
# TGS_LOGIN_PATH=/api/Login
# TGS_PATH_GET_CUSTOMER=/api/Fidelity/GetCustomer
# TGS_PATH_INSERT_UPDATE_CUSTOMER=/api/Fidelity/InsertUpdateCustomer
# TGS_PATH_ADD_FIDELITY=/api/Fidelity/AddFidelity
# TGS_PATH_GET_VALUE_FIDELITY=/api/Fidelity/GetValueFidelity
# TGS_PATH_INSERT_VALUE_FIDELITY=/api/Fidelity/InsertValueFidelity
